# D-5: the build stage needs only package*.json, tsconfig*.json, src/, bin/,
# skills/, scripts/build-skills.mjs, README.md and LICENSE. Keep secrets,
# build output and tooling out of the build context.
**
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.build.json
!src/**
!bin/**
!skills/**
!scripts/build-skills.mjs
!README.md
!LICENSE
