# ServiceNow connection credentials.
# Copy this file to .env and fill in your values, or use the
# `servicenow_set_credentials` tool which writes them here automatically.

# Instance host. Accepts "dev12345" or "dev12345.service-now.com" or a full URL.
SN_INSTANCE=your-instance.service-now.com

# ServiceNow username.
SN_USER=your.username@example.com

# ServiceNow password.
SN_PASSWORD=your-password

# Operator opt-out (H-2): let servicenow_set_credentials proceed on MCP clients
# without elicitation support (no confirmation prompt). An explicit decline is
# still refused. Off by default.
# SN_ALLOW_UNCONFIRMED_CREDENTIAL_CHANGE=false

# --- Optional tuning (defaults shown, all commented out) ---
# Per-request timeout in milliseconds.
# SN_TIMEOUT_MS=30000
# Retries for transient failures (429/503 any method; 502/504 and network errors on GET).
# SN_MAX_RETRIES=2
# Upper bound (ms) honoured for a Retry-After header on 429/503.
# SN_RETRY_AFTER_MAX_MS=60000
# Total budget (ms) for one logical request across retries, backoff, queue wait
# and OAuth re-auth; default max(120000, 2 x SN_TIMEOUT_MS). Exceeding it fails
# with code DEADLINE_EXCEEDED.
# SN_DEADLINE_MS=120000
# Hard cap on records returned when a query uses fetchAll.
# SN_MAX_RECORDS=10000
# Max characters in a query result before the record set is truncated (the
# result says so and names format:"file"; other oversized results gain a note).
# SN_MAX_RESULT_CHARS=100000
# S-11: write snapshot / compare / diagram results over SN_MAX_RESULT_CHARS to a
# file under SN_DOCS_DIR (<profile>/exports/, <profile>/diagrams/) and return
# {path, bytes, preview} instead of the full result (default off).
# SN_OVERSIZE_TO_FILE=false
# Comma-separated host allowlist for custom or sovereign-cloud domains. When set,
# only these hosts (or their subdomains) are allowed. Internal/loopback hosts stay
# blocked unless an entry names them exactly (a suffix entry never opens one).
# When unset, only *.service-now.com instances are reachable.
# SN_ALLOWED_HOSTS=service-now.com
# Largest response body read into memory (bytes, default 50 MiB); larger bodies
# fail with RESPONSE_TOO_LARGE. Redirects are never followed (REDIRECT_BLOCKED).
# SN_MAX_BODY_BYTES=52428800

# --- Authentication (defaults to Basic) ---
# Method: basic | oauth | apikey | token | none (cert-only mTLS).
# Auto-detected from the keys present: API key -> bearer -> OAuth -> Basic.
# SN_AUTH=basic
#
# API Key (ServiceNow Inbound API Keys) -> sent as the x-sn-apikey header:
# SN_API_KEY=
# A pre-obtained bearer token, used verbatim:
# SN_BEARER_TOKEN=
# ...or a file holding it (wins over SN_BEARER_TOKEN; re-read once on a 401 so an
# external issuer can rotate it):
# SN_TOKEN_FILE=
# ISO 8601 expiry of the bearer token — status/doctor warn when < 24 h remain:
# SN_TOKEN_EXPIRES_AT=2026-12-31T23:59:59Z
# OAuth client credentials registered in ServiceNow (Application Registry).
# SN_OAUTH_CLIENT_ID=
# SN_OAUTH_CLIENT_SECRET=
#
# RECOMMENDED — OAuth 2.1 Authorization Code + PKCE. Register an "Authorization
# Code" endpoint with this loopback redirect, then run:  npx servicenow-mcp-ai login
# It stores SN_OAUTH_REFRESH_TOKEN and sets SN_OAUTH_GRANT=refresh_token for you.
# SN_OAUTH_REDIRECT_URI=http://localhost:53682/callback
# SN_OAUTH_SCOPE=
#
# Grant type: refresh_token (recommended, set by `login`), client_credentials,
# jwt_bearer, or password (DEPRECATED — ROPC, disabled on many instances).
# SN_OAUTH_GRANT=refresh_token
# Refresh token for the refresh_token grant (obtained by `login`).
# SN_OAUTH_REFRESH_TOKEN=
#
# OAuth JWT-bearer grant (service account, no password). PEM private key + claims;
# the public cert is registered on the ServiceNow JWT provider.
# SN_OAUTH_GRANT=jwt_bearer
# SN_OAUTH_JWT_KEY=            # or SN_OAUTH_JWT_KEY_FILE=/path/key.pem
# SN_OAUTH_JWT_SUB=           # subject/user (default: SN_USER)
# SN_OAUTH_JWT_ISS=           # default: client id
# SN_OAUTH_JWT_AUD=           # default: https://<host>/oauth_token.do
# SN_OAUTH_JWT_KID=           # key id header, when the provider requires one
# SN_OAUTH_JWT_EXP_SEC=300    # assertion lifetime in seconds

# --- Mutual TLS (client certificate) — needs the optional `undici` package ---
# Presents a client cert on the TLS handshake; ServiceNow maps it to a user.
# Combine with any method above, or use SN_AUTH=none for cert-only.
# SN_TLS_CLIENT_CERT=         # or SN_TLS_CLIENT_CERT_FILE=/path/cert.pem
# SN_TLS_CLIENT_KEY=          # or SN_TLS_CLIENT_KEY_FILE=/path/key.pem
# SN_TLS_CA=                  # or SN_TLS_CA_FILE=/path/ca.pem
# SN_TLS_REJECT_UNAUTHORIZED=true

# --- Outbound proxy and identity — the proxy needs the optional `undici` package ---
# Explicit HTTPS proxy for all ServiceNow/OAuth traffic (ignores NO_PROXY). When
# unset, HTTPS_PROXY / HTTP_PROXY are honoured together with NO_PROXY.
# SN_HTTPS_PROXY=http://user:pass@proxy.example.com:3128
# Extra token appended to the User-Agent
# "servicenow-mcp-ai/<version> (node/<major>; <transport>; <client>)".
# SN_USER_AGENT_SUFFIX=team-platform

# --- Named connection profiles (multi-instance) ---
# The bare SN_INSTANCE/SN_USER/SN_PASSWORD above are the 'default' profile.
# Define more instances with prefixed keys; switch via SN_ACTIVE_PROFILE or
# the servicenow_use_instance tool.
# SN_PROFILE_DEV_INSTANCE=dev12345.service-now.com
# SN_PROFILE_DEV_USER=dev.user
# SN_PROFILE_DEV_PASSWORD=secret
# SN_ACTIVE_PROFILE=default

# --- Access policy (least privilege) ---
# Comma-separated allowlist of tables; when set, only these are reachable.
# SN_TABLES_ALLOW=incident,change_request
# Comma-separated denylist of tables; always wins over the allowlist.
# SN_TABLES_DENY=sys_user,sys_user_has_role
# Read-only mode: refuse every create/update/delete when truthy.
# SN_READONLY=false
# Plan-and-apply write mode (DF-2): plan (default) previews a write as a
# before/after diff without mutating; apply executes. A tool's apply:true
# forces execution for a single call.
# SN_WRITE_MODE=plan
# H-3: confirmation for a destructive apply:true (delete_record,
# delete_attachment, a writing batch, send_email, order_catalog_item,
# revert_write, change_conflicts with calculate:true) in plan mode. off (default) = no extra check; token = the plan
# preview returns a single-use plan_token that the apply must pass back with the
# same arguments (PLAN_REQUIRED otherwise); elicit = token plus a confirmation
# prompt on clients that support elicitation. SN_WRITE_MODE=apply bypasses it.
# SN_DESTRUCTIVE_CONFIRM=token
# Lifetime of a plan_token in seconds (default 600, 30-86400).
# SN_PLAN_TOKEN_TTL_SEC=600
# H-4: a batch sub-request whose REST path no tool package owns. allow (default)
# = table / read-only checks only; deny = refused. A nested batch is always refused.
# SN_BATCH_UNMAPPED=deny
# Most sub-requests one servicenow_batch call may carry (1-1000, default 1000).
# SN_BATCH_MAX_REQUESTS=50
# Update set (sys_id or exact name) that applied Table-tool writes
# (create / update / upsert / delete) are recorded in (S-6). The server switches
# the user's current update set for the write and restores it afterwards; the
# plan preview names the set. A per-call update_set argument overrides it, and
# SN_PROFILE_<NAME>_UPDATE_SET sets it per profile. Data-row tables (incident,
# CMDB…) are never captured by update sets and are written unchanged.
# SN_UPDATE_SET=Sprint 12
# Email recipient allow-list for servicenow_send_email (domains; a domain also
# covers its subdomains; * = any). When unset, every recipient must be the email
# of a user in the instance's own sys_user table.
# SN_EMAIL_ALLOWED_DOMAINS=example.com
# Attachment upload guards: max decoded size (default 10 MiB) and an optional
# content-type allow-list (exact types or type/* wildcards).
# SN_MAX_UPLOAD_BYTES=10485760
# SN_UPLOAD_MIME_ALLOW=text/plain,image/*,application/pdf
# Field redaction (DF-5): mask these field values before records reach the model.
# SN_REDACT_FIELDS=email,phone,ssn
# Also mask email/phone/national-id patterns inside any string value.
# SN_REDACT_PII=false
# Write journal (H-5): rotate write-journal.jsonl at this size (default 20 MiB).
# SN_JOURNAL_MAX_BYTES=20971520
# CSV exports (H-5): neutralise formula-like cells with a leading ' (default on)
# and prepend a UTF-8 BOM (default on). Set 0 to opt out of either.
# SN_CSV_FORMULA_GUARD=1
# SN_CSV_BOM=1

# --- Transport (DF-6) ---
# stdio (default, one local client) or http (Streamable HTTP for remote/agent use).
# Securing the http endpoint (TLS, auth, network) is the operator's responsibility.
# SN_TRANSPORT=stdio
# SN_PORT=3000
# Bind host (default loopback) and an optional bearer token for the http transport.
# When SN_HTTP_TOKEN is set, every request must send Authorization: Bearer <token>.
# SN_HTTP_HOST=127.0.0.1
# SN_HTTP_TOKEN=change-me

# --- Observability ---
# Log level on stderr: error | warn | info | debug.
# SN_LOG_LEVEL=info
# Log line format on stderr: json (default, one JSON object per line) | text
# (human-readable `HH:MM:SS level message key=value`).
# SN_LOG_FORMAT=json
# Also append every log line (always JSON Lines, redacted like stderr) to this
# file, created with 0600 permissions. Rotated by size: the live file moves to
# <file>.1 and the five newest generations are kept. Stderr keeps working.
# SN_LOG_FILE=/var/log/servicenow-mcp.log
# Rotation threshold for SN_LOG_FILE in bytes (default 10485760 = 10 MiB).
# SN_LOG_FILE_MAX_BYTES=10485760
# HTTP transport only: serve Prometheus metrics at GET /metrics. Requires
# SN_HTTP_TOKEN (the endpoint is behind the same bearer check); without a
# token it stays disabled and a warning is logged.
# SN_METRICS=0
# Log lines mirrored to the MCP client per second and session (burst: 50 or the
# rate, if larger). Lines over it are counted and reported in one "suppressed"
# warning per minute; stderr always gets every line. 0 = no limit.
# SN_LOG_NOTIFY_RATE=20
# EXPERIMENTAL (M-9): long-running tools (snapshot, compare, ATF runs, code
# health, query_table format:"file") accept run_as_task:true and return an MCP
# task handle; poll with tasks/get, read with tasks/result (kept 1 h, redacted),
# stop with tasks/cancel. Off by default; the SDK task API may change.
# SN_EXPERIMENTAL_TASKS=0

# --- Performance ---
# Opt-in to the Code Search API (sn_codesearch plugin) for search_code; falls
# back to the LIKE iteration on any failure. Off by default.
# SN_CODESEARCH=false
# TTL (seconds) for the schema reads cache (list_tables/describe_table/
# get_cmdb_meta); 0 disables caching.
# SN_SCHEMA_CACHE_TTL_SEC=300
# Maximum entries in the schema reads cache (least-recently-used eviction).
# SN_SCHEMA_CACHE_MAX=256
# How long a successful capability / plugin-API probe is cached (default 10 min).
# SN_CAPABILITY_TTL_MS=600000
# How long a failed capability probe or missing plugin API is cached (default 60 s).
# Transport errors are never cached.
# SN_PLUGIN_NEGATIVE_TTL_MS=60000
# Maximum parallel HTTP requests to the instance.
# SN_MAX_CONCURRENT=4
# Requests allowed to wait per host for a free slot; overflow fails with code BUSY.
# SN_MAX_QUEUE=64
# Longest wait (ms) for a slot before failing with code BUSY; default SN_TIMEOUT_MS.
# SN_QUEUE_TIMEOUT_MS=30000
# Opt-in per-host circuit breaker: consecutive failures (transport, deadline,
# 5xx) before requests fail fast with code CIRCUIT_OPEN. 0 (default) = off.
# SN_BREAKER_THRESHOLD=0
# How long (ms) an open breaker rejects requests before a trial request.
# SN_BREAKER_RESET_MS=30000

# --- Output shaping (token savings; both default to the lean variant) ---
# Include reference field 'link' URLs in results (default: excluded).
# SN_INCLUDE_REF_LINKS=false
# Pretty-print JSON results (default: compact).
# SN_RESULT_PRETTY=false

# --- Tool packages ---
# Comma/space-separated profiles or package names to register.
# Profiles: core (default) = table,schema,aggregate,attachment; all = everything.
# Packages: table, schema, aggregate, attachment, importset, batch,
#           catalog, change, knowledge, cmdb, scripts, flows, codecheck, docs,
#           instance, email, atf, revert, artifacts, updatesets, ops, history,
#           properties, directory, ui.
# The admin tools (set_credentials, get_status) are always registered.
# SN_TOOL_PACKAGES=core
# Packages to exclude even when enabled above. Note: SN_TABLES_DENY does NOT
# cover the plugin APIs (catalog/change/knowledge…) — this is how you block them.
# SN_PACKAGES_DENY=change,catalog
# Packages registered with their read tools only (write tools are dropped).
# SN_PACKAGES_READONLY=cmdb

# --- Self-documentation (docs package) ---
# Directory the docs tools read/write Markdown in (default docs/instance).
# It also holds the write journal — keep it out of version control.
# SN_DOCS_DIR=docs/instance
# Per-file size cap for the docs tools (default 5 MiB): larger writes are refused,
# reads are truncated, search skips the file.
# SN_DOCS_MAX_FILE_BYTES=5242880
# Generated docs older than this many days are listed as stale (default 30).
# SN_DOCS_STALE_DAYS=30
# Most matches servicenow_docs_search returns (default 200).
# SN_DOCS_SEARCH_MAX=200
# Node cap for generated Mermaid diagrams; the rest fold into "+N more" (default 200).
# SN_DIAGRAM_MAX_NODES=200

# --- SDK-managed scopes (P-3) ---
# Scopes you declare as managed by a ServiceNow SDK (Fluent) project: scope
# names or sys_scope sys_ids. Highest source of authority (default order,
# pending owner gate O-6).
# SN_SDK_MANAGED_SCOPES=x_acme_app
# Directories scanned (read-only, bounded, no symlinks) for SDK projects; each
# now.config.json marks its scope / scopeId as SDK-managed. Separate with
# commas or the platform path delimiter; relative paths resolve against the
# working directory (no ~ expansion).
# SN_SDK_PROJECT_DIRS=../acme-app,../acme-portal

# --- Configuration file location ---
# Explicit path to the env file to read/write. Otherwise the server uses
# ~/.config/sincronia-mcp/.env (if present) or this project-root .env.
# SN_ENV_FILE=
