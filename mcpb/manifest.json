{
  "manifest_version": "0.3",
  "name": "servicenow-mcp-ai",
  "display_name": "ServiceNow MCP",
  "version": "2.0.1",
  "description": "ServiceNow MCP server: 100 tools in 26 packages over the full REST surface (Table, Aggregate, Attachment, Import Set, Batch, CMDB/IRE, Catalog, Change, Knowledge, Email) with script intelligence, flow tracing, local code checking, ATF runs, multi-instance profiles, Mermaid generators and a two-axis policy model.",
  "author": { "name": "Ivan Baev", "email": "ivanbbaev@gmail.com" },
  "repository": {
    "type": "git",
    "url": "https://github.com/IvanBBaev/servicenow-mcp-ai.git"
  },
  "homepage": "https://github.com/IvanBBaev/servicenow-mcp-ai#readme",
  "documentation": "https://ivanbbaev.github.io/servicenow-mcp-ai/",
  "support": "https://github.com/IvanBBaev/servicenow-mcp-ai/issues",
  "icon": "icon.png",
  "server": {
    "type": "node",
    "entry_point": "build/index.js",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/build/index.js"],
      "env": {
        "SN_INSTANCE": "${user_config.instance}",
        "SN_USER": "${user_config.user}",
        "SN_PASSWORD": "${user_config.password}",
        "SN_AUTH": "${user_config.auth}",
        "SN_API_KEY": "${user_config.api_key}",
        "SN_BEARER_TOKEN": "${user_config.bearer_token}",
        "SN_TOKEN_FILE": "${user_config.token_file}",
        "SN_TOKEN_EXPIRES_AT": "${user_config.token_expires_at}",
        "SN_OAUTH_CLIENT_ID": "${user_config.oauth_client_id}",
        "SN_OAUTH_CLIENT_SECRET": "${user_config.oauth_client_secret}",
        "SN_OAUTH_GRANT": "${user_config.oauth_grant}",
        "SN_OAUTH_REFRESH_TOKEN": "${user_config.oauth_refresh_token}",
        "SN_OAUTH_REDIRECT_URI": "${user_config.oauth_redirect_uri}",
        "SN_OAUTH_SCOPE": "${user_config.oauth_scope}",
        "SN_OAUTH_JWT_KEY": "${user_config.oauth_jwt_key}",
        "SN_OAUTH_JWT_KEY_FILE": "${user_config.oauth_jwt_key_file}",
        "SN_OAUTH_JWT_ISS": "${user_config.oauth_jwt_iss}",
        "SN_OAUTH_JWT_SUB": "${user_config.oauth_jwt_sub}",
        "SN_OAUTH_JWT_AUD": "${user_config.oauth_jwt_aud}",
        "SN_OAUTH_JWT_KID": "${user_config.oauth_jwt_kid}",
        "SN_OAUTH_JWT_EXP_SEC": "${user_config.oauth_jwt_exp_sec}",
        "SN_ALLOW_UNCONFIRMED_CREDENTIAL_CHANGE": "${user_config.allow_unconfirmed_credential_change}",
        "SN_TOOL_PACKAGES": "${user_config.tool_packages}"
      }
    }
  },
