  "license": "MIT",
  "compatibility": {
    "claude_desktop": ">=0.10.0",
    "platforms": ["darwin", "win32", "linux"],
    "runtimes": { "node": ">=22.12" }
  },
  "user_config": {
    "instance": {
      "type": "string",
      "title": "Instance",
      "description": "Instance name, host, or https:// URL (dev12345, dev12345.service-now.com). (SN_INSTANCE)",
      "required": true
    },
    "user": {
      "type": "string",
      "title": "User",
      "description": "ServiceNow username for Basic auth. (SN_USER)",
      "required": false
    },
    "password": {
      "type": "string",
      "title": "Password",
      "description": "ServiceNow password. Never logged or returned by any tool. (SN_PASSWORD)",
      "required": false,
      "sensitive": true
    },
    "auth": {
      "type": "string",
      "title": "Auth",
      "description": "Auth method: basic, oauth, apikey, token or none (cert-only mTLS). Auto-detected from the keys present (API key → bearer → OAuth → Basic). Default: auto. (SN_AUTH)",
      "required": false
    },
    "api_key": {
      "type": "string",
      "title": "API key",
      "description": "ServiceNow Inbound API Key, sent as the x-sn-apikey header (enables apikey mode). (SN_API_KEY)",
      "required": false,
      "sensitive": true
    },
    "bearer_token": {
      "type": "string",
      "title": "Bearer token",
      "description": "A pre-obtained bearer token, sent verbatim as Authorization: Bearer … (enables token mode). (SN_BEARER_TOKEN)",
      "required": false,
      "sensitive": true
    },
    "token_file": {
      "type": "file",
      "title": "Token file",
      "description": "File holding the bearer token (enables token mode; wins over SN_BEARER_TOKEN). Re-read once when the instance rejects the token with 401, so an external issuer can rotate it; otherwise the call fails with AUTH_EXPIRED. (SN_TOKEN_FILE)",
      "required": false
    },
    "token_expires_at": {
      "type": "string",
      "title": "Token expires at",
      "description": "ISO 8601 expiry of the bearer token. get_status / doctor warn when less than 24 h remain, when it has passed, or when it cannot be parsed. (SN_TOKEN_EXPIRES_AT)",
      "required": false
    },
    "oauth_client_id": {
      "type": "string",
      "title": "OAuth client ID",
      "description": "OAuth client id (its presence enables OAuth). (SN_OAUTH_CLIENT_ID)",
      "required": false
    },
    "oauth_client_secret": {
      "type": "string",
      "title": "OAuth client secret",
      "description": "OAuth client secret. (SN_OAUTH_CLIENT_SECRET)",
      "required": false,
      "sensitive": true
    },
    "oauth_grant": {
      "type": "string",
      "title": "OAuth grant",
      "description": "OAuth grant: password (deprecated — ROPC), client_credentials, refresh_token or jwt_bearer. The login command sets this to refresh_token for you. Any other value fails every OAuth request. Default: password. (SN_OAUTH_GRANT)",
      "required": false
    },
    "oauth_refresh_token": {
      "type": "string",
      "title": "OAuth refresh token",
      "description": "Refresh token for the refresh_token grant. Obtained automatically by npx servicenow-mcp-ai login (Authorization Code + PKCE). (SN_OAUTH_REFRESH_TOKEN)",
      "required": false,
      "sensitive": true
    },
    "oauth_redirect_uri": {
      "type": "string",
      "title": "OAuth redirect URI",
      "description": "Loopback redirect URL for the PKCE login flow. Must match the redirect registered on the OAuth endpoint. Default: http://localhost:53682/callback. (SN_OAUTH_REDIRECT_URI)",
      "required": false
    },
    "oauth_scope": {
      "type": "string",
      "title": "OAuth scope",
      "description": "Optional OAuth scope requested during login. (SN_OAUTH_SCOPE)",
      "required": false
    },
    "oauth_jwt_key": {
      "type": "string",
      "title": "OAuth JWT key",
      "description": "PEM private key for the jwt_bearer grant (or SN_OAUTH_JWT_KEY_FILE); the public certificate is registered on the ServiceNow JWT provider. (SN_OAUTH_JWT_KEY)",
      "required": false,
      "sensitive": true
    },
    "oauth_jwt_key_file": {
      "type": "file",
      "title": "OAuth JWT key file",
      "description": "Path to the PEM private key for the jwt_bearer grant. (SN_OAUTH_JWT_KEY_FILE)",
      "required": false
    },
    "oauth_jwt_iss": {
      "type": "string",
      "title": "OAuth JWT iss",
      "description": "iss claim of the JWT-bearer assertion. Default: client id. (SN_OAUTH_JWT_ISS)",
      "required": false
    },
    "oauth_jwt_sub": {
      "type": "string",
      "title": "OAuth JWT sub",
      "description": "sub claim (the user) of the JWT-bearer assertion. Default: SN_USER. (SN_OAUTH_JWT_SUB)",
      "required": false
    },
    "oauth_jwt_aud": {
      "type": "string",
      "title": "OAuth JWT aud",
      "description": "aud claim of the JWT-bearer assertion. Default: https://<host>/oauth_token.do. (SN_OAUTH_JWT_AUD)",
      "required": false
    },
    "oauth_jwt_kid": {
      "type": "string",
      "title": "OAuth JWT kid",
      "description": "kid header of the JWT-bearer assertion, when the provider requires one. (SN_OAUTH_JWT_KID)",
      "required": false
    },
    "oauth_jwt_exp_sec": {
      "type": "number",
      "title": "OAuth JWT exp (seconds)",
      "description": "Lifetime of the JWT-bearer assertion in seconds. Default: 300. (SN_OAUTH_JWT_EXP_SEC)",
      "required": false
    },
    "allow_unconfirmed_credential_change": {
      "type": "boolean",
      "title": "Allow unconfirmed credential change",
      "description": "H-2: operator opt-out — lets servicenow_set_credentials proceed on MCP clients without elicitation support (no confirmation prompt, no live server). An explicit decline is still refused. Off by default. Default: false. (SN_ALLOW_UNCONFIRMED_CREDENTIAL_CHANGE)",
      "required": false
    },
    "tool_packages": {
      "type": "string",
      "title": "Tool packages",
      "description": "Comma/space-separated tool packages or profiles to enable. Profiles: core (default), all and the presets reader | developer | admin (see Presets). Packages: table, schema, aggregate, attachment, importset, batch, catalog, change, knowledge, cmdb, scripts, flows, codecheck, docs, instance, email, atf, revert, artifacts, updatesets, ops, history, properties, directory, ui. The admin tools are always on. atf runs tests on the instance — enable it only on a non-production instance. Default: core. (SN_TOOL_PACKAGES)",
      "required": false
    }
  }
}
