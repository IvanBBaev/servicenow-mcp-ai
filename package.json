{
  "name": "servicenow-mcp-ai",
  "version": "2.0.1",
  "mcpName": "io.github.IvanBBaev/servicenow-mcp-ai",
  "description": "ServiceNow MCP server: 97 tools in 26 packages over the full REST surface (Table, Aggregate, Attachment, Import Set, Batch, CMDB/IRE, Catalog, Change, Knowledge, Email) with script intelligence, flow tracing, local code checking, ATF runs, multi-instance profiles, Mermaid generators and a two-axis policy model.",
  "license": "MIT",
  "author": "Ivan Baev <ivanbbaev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IvanBBaev/servicenow-mcp-ai.git"
  },
  "homepage": "https://github.com/IvanBBaev/servicenow-mcp-ai#readme",
  "bugs": {
    "url": "https://github.com/IvanBBaev/servicenow-mcp-ai/issues"
  },
  "type": "module",
  "bin": {
    "servicenow-mcp-ai": "./bin/servicenow-mcp-ai.cjs"
  },
  "main": "./build/index.js",
  "files": [
    "build",
    "!build/**/*.map",
    "!build/**/jira/**",
    "bin"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && tsc && node -e \"try{require('fs').chmodSync('build/index.js',0o755)}catch{}\"",
    "watch": "tsc --watch",
    "start": "node build/index.js",
    "dev": "node --watch build/index.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "c8 --check-coverage --lines 94 --branches 82 --functions 97 --reporter=text-summary --reporter=lcov node --test test/*.test.js",
    "lint": "eslint . --ignore-pattern \"extension/**\"",
    "format": "prettier --write . && prettier --write .",
    "format:check": "prettier --check .",
    "inspector": "npx @modelcontextprotocol/inspector node build/index.js",
    "docs:readme": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/readme-tools.mjs",
    "docs:env": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/env-docs.mjs",
    "docs:sync": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/docs-sync.mjs",
    "docs:instructions": "node scripts/agent-instructions.mjs",
    "test:full": "npm run build && node --test test/*.test.js",
    "sdk:drift": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/sdk-drift.mjs",
    "scan:surface": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/scan-surface.mjs",
    "gen:manifest": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/gen-manifest.mjs",
    "verify": "npm run build && npm run lint && npm run format:check && node --test test/*.test.js",
    "pack:check": "node scripts/pack-check.mjs",
    "mcpb:manifest": "node --experimental-transform-types --disable-warning=ExperimentalWarning scripts/mcpb-manifest.mjs",
    "mcpb:pack": "npm run build && node scripts/mcpb-pack.mjs",
    "check": "npm run build && npm run lint && npm run format:check && npm run docs:env -- --check && npm run docs:sync -- --check && npm run docs:instructions -- --check && npm run scan:surface && npm run mcpb:manifest -- --check && npm run fluent:actions -- --check && npm run test:coverage && npm run pack:check && npm audit --omit=dev --audit-level=high",
    "release:dry": "npm run check && npm publish --dry-run",
    "version:sync": "node scripts/sync-version.mjs",
    "version": "node scripts/sync-version.mjs && git add server.json extension/package.json extension/package-lock.json .claude-plugin/plugin.json mcpb/manifest.json docs/index.html",
    "prepublishOnly": "npm run check",
    "fluent:verify": "node scripts/fluent-verify.mjs",
    "fluent:actions": "node scripts/gen-fluent-actions.mjs",
    "eval:skills": "claude plugin eval . --trust-plugin --no-publish",
    "eval:mocks": "npm run build && node test/evals/record-mocks.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "acorn": "^8.18.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@servicenow/sdk": "4.12.2",
    "@types/node": "^22.20.4",
    "c8": "^12.0.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "prettier": "~3.8.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "servicenow",
    "llm",
    "ai",
    "rest"
  ],
  "trademark": "servicenow-mcp-ai is an independent, community-built project and is not affiliated with, endorsed by, or sponsored by ServiceNow, Inc. ServiceNow and related marks are trademarks or registered trademarks of ServiceNow, Inc., used here only nominatively to indicate compatibility."
}
